{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix extension --include=dev",
  "buildCommand": "npm --prefix extension run compile-tests && npm --prefix extension run package:vsix && node website/build.mjs",
  "outputDirectory": "website/dist",
  "rewrites": [
    { "source": "/api/studio/config", "destination": "/api/studio/config.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/downloads/charmlet.vsix",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"charmlet.vsix\"" }
      ]
    },
    {
      "source": "/packs/(.*)",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ]
}
