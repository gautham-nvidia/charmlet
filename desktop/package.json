{
  "name": "charmlet-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Charmlet desktop developer beta",
  "main": "dist/main.cjs",
  "scripts": {
    "check-types": "node ../extension/node_modules/typescript/bin/tsc -p . --noEmit",
    "build": "npm run check-types && node build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/model.test.cjs && node test/smoke.mjs",
    "package": "npm run build && node package.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron/packager": "20.3.0"
  }
}
