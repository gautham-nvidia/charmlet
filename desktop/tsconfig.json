{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["../extension/node_modules/@types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
